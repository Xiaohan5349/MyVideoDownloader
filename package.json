{
  "name": "ds-video-downloader",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "scripts": {
    "helper": "node helper/server.js",
    "helper:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper-control.ps1 start",
    "helper:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper-control.ps1 stop",
    "helper:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper-control.ps1 restart",
    "helper:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper-control.ps1 status",
    "helper:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper-control.ps1 install-autostart",
    "helper:autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper-control.ps1 uninstall-autostart",
    "helper:autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper-control.ps1 autostart-status",
    "test": "node --test tests/*.test.mjs"
  }
}
