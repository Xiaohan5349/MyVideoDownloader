{
  "manifest_version": 3,
  "name": "__MSG_brandName__",
  "short_name": "__MSG_brandShortName__",
  "version": "1.6.2",
  "description": "__MSG_brandDescription__",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "__MSG_brandName__"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/inject-main.js"],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/hls-browser.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "permissions": ["tabs", "storage", "webRequest"],
  "optional_permissions": ["downloads"]
}
